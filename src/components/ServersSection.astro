---
import SectionHeading from './SectionHeading.astro';
import ServerCard from './ServerCard.astro';
import Notice from './NoticeWithLink.astro';
---

<section id="servers" class="scroll-mt-24 space-y-8">
  <div data-reveal>
    <SectionHeading num="02." title="自建联机服务器 // DEDICATED SERVER" tag="SERVER" />
  </div>

  <!-- 服务器状态由 scripts/main.ts 从 src/data/server.ts 配置的接口实时拉取 -->
  <div class="grid grid-cols-1 gap-6 md:max-w-2xl">
    <ServerCard />
  </div>

  <Notice
    icon="!"
    content="目前该部分并不完善，我们还没想到稳定获取服务器状态的方法。"
    link="javascript:alert('占位符链接')"
    linkText="如何使用服务器插件"
  />
</section>
