---
import SectionHeading from './SectionHeading.astro';
import GithubIcon from './icons/GithubIcon.astro';
import DocIcon from './icons/DocIcon.astro';

const GITHUB_URL = 'https://github.com/MonoIAR/PJ_LabLocalizer/releases/';
const INSTALL_DOCS_URL = '/docs/install-bonelab-zh/';

const githubLink = GITHUB_URL
  ? { href: GITHUB_URL, target: '_blank', rel: 'noopener' }
  : { href: '#', 'data-alert': '占位符：GitHub 仓库地址待补充' };

const features = [
  {
    label: '[TEXT]',
    title: '文本汉化',
    desc: '完整翻译 BONELAB 的剧情与系统文本，完全由人工翻译和校对，让中文玩家无缝沉浸于 Stress Level Zero 的世界观。',
  },
  {
    label: '[TEXTURE]',
    title: '贴图汉化',
    desc: '我们自己做了贴图替换模组，然后人工绘制了中文版本的贴图，使得部分设定更易于理解。',
  },
  {
    label: '[SUBTITLE]',
    title: '字幕模组',
    desc: '由于游戏大体剧情通过语音呈现，所以我们为BONELAB带来了字幕，这也是我们区别于常规汉化包的核心卖点。',
  },
];
---

<section id="localization" class="scroll-mt-24 space-y-8">
  <SectionHeading num="01." title="BONELAB-ZH 汉化包 // Project LabLocalizer" tag="LOCALIZATION" />

  <div class="hud-box p-8 space-y-8">
    <!-- 简介 -->
    <p class="max-w-3xl text-sm md:text-base text-brand-textMuted leading-relaxed font-sans">
      BONELAB-ZH 不仅覆盖了
      <span class="text-white font-semibold">文本汉化</span>
      与
      <span class="text-white font-semibold">贴图汉化</span>，
      更包含STAFF团队
      <span class="text-brand-accent font-semibold">自研的字幕模组</span>
      ——带来有别于常规汉化包的完整体验。
    </p>

    <!-- 三大卖点 -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        features.map((f) => (
          <div class="hud-box p-5 group hover:border-brand-accent transition-colors">
            <h3 class="font-mono font-bold text-white mt-3">{f.title}</h3>
            <p class="text-xs text-brand-textMuted mt-1 font-sans leading-relaxed">{f.desc}</p>
          </div>
        ))
      }
    </div>

    <!-- 操作按钮 -->
    <div class="flex flex-wrap gap-4 font-mono text-sm pt-2">
      <a
        {...githubLink}
        class="bg-brand-accent hover:bg-brand-accentHover text-white px-6 py-3 font-semibold transition-all flex items-center gap-2 clip-corner glow-accent"
      >
        <GithubIcon class="w-4 h-4" />
        GitHub Releases
      </a>
      <a
        href={INSTALL_DOCS_URL}
        class="bg-brand-surface border border-brand-border hover:border-white text-white px-6 py-3 font-semibold transition-colors flex items-center gap-2 clip-corner"
      >
        <DocIcon class="w-4 h-4 text-brand-accent" />
        教程文档
      </a>
    </div>
  </div>
</section>
