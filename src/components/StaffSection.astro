---
import SectionHeading from './SectionHeading.astro';
import StaffCard from './StaffCard.astro';
import Notice from './Notice.astro';

const staff = [
  {
    role: '[MAIN DEV]',
    name: 'CAitVR',
    desc: 'CAitVR 属于动物界、脊索动物门、脊椎动物亚门、哺乳纲、真兽亚纲、食肉目、猫科、猫属、家猫种（*Felis catus*）雄性样本。机体拥有高度特化且高度发达的中枢神经系统，大脑具备复杂环境感知、空间认知、行为学习与长期记忆存储能力，可执行四足行走、奔跑、跳跃与攀爬等运动模式。个体拥有完整的骨骼、肌肉、循环、呼吸、消化、泌尿、生殖、神经、内分泌系统，符合真兽类哺乳动物恒温、胎生、乳汁哺育后代的核心生物学特征。四肢末端拥有高度灵活的趾骨结构与可伸缩爪，前肢具备较强的抓握、拨动与精细操作能力，头部拥有发达的视觉、听觉、嗅觉与触觉感知系统，耳廓具备较高机动性，可根据声源方向进行独立或协同转动。',
    bilibili: 'https://space.bilibili.com/551018791',
    avatar: '/staff/cait.webp',
  },
  {
    role: '[LOCALIZATION & DEV]',
    name: 'ChakerAt',
    desc: '负责翻译、校对和部分开发任务',
    bilibili: 'https://space.bilibili.com/1543261354',
    avatar: '/staff/cha.webp',
  },
  {
    role: '[LOCALIZATION]',
    name: '白米粥不好喝',
    desc: '制作汉化贴图',
    bilibili: 'https://space.bilibili.com/3546575859092005',
    avatar: '',
  },
  {
    role: '[MODERATOR]',
    name: 'sDOR',
    desc: '（疑似）吉祥物。裹尸袋批发。',
    bilibili: 'https://space.bilibili.com/548875815',
    avatar: '/staff/sdor.webp',
  },
];
---

<section id="staff" class="scroll-mt-24 space-y-8">
  <div data-reveal>
    <SectionHeading num="03." title="STAFF 团队 //" tag="MIAR_STAFF_TEAM" />
  </div>
  <Notice icon="?" content="这些介绍都是成员自己撰写的，完全不具备参考价值，可能是完全瞎写的。" />
  <!-- Staff Profile Rows (一行一个，右侧为哔哩哔哩链接) -->
  <div data-reveal-stagger class="space-y-6">
    {staff.map((member) => <StaffCard {...member} />)}
  </div>
</section>
