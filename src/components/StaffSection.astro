    bilibili: 'https://space.bilibili.com/551018791',
    avatar: '/staff/cait.webp',
  },
  {
    role: '[LOCALIZATION & DEV]',
    name: 'ChakerAt',
    desc: '负责翻译、校对和部分开发任务',
    bilibili: 'https://space.bilibili.com/1543261354',
    avatar: '/staff/cha.webp',
  },
  {
    role: '[LOCALIZATION]',
    name: '白米粥不好喝',
    desc: '制作汉化贴图',
    bilibili: 'https://space.bilibili.com/3546575859092005',
    avatar: '',
  },
  {
    role: '[MODERATOR]',
