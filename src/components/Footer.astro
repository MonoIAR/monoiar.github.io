---
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-5xl px-6 py-14">
    <div class="flex flex-col items-start justify-between gap-10 md:flex-row md:items-center">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="block size-2 bg-accent" aria-hidden="true"></span>
          <span class="font-mono text-lg font-semibold uppercase tracking-[0.3em]">MIAR</span>
        </div>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-fg-muted">
          面向中文玩家的 BONELAB 社区，专注汉化与联机生态。
        </p>
      </div>

      <nav aria-label="页脚导航">
        <ul class="flex flex-col gap-2.5 text-sm text-fg-muted">
          <li><a href="/#intro" class="transition-colors hover:text-fg">介绍</a></li>
          <li><a href="/localization" class="transition-colors hover:text-fg">汉化包</a></li>
          <li><a href="/#servers" class="transition-colors hover:text-fg">联机服务器</a></li>
          <li><a href="/#staff" class="transition-colors hover:text-fg">核心 STAFF</a></li>
        </ul>
      </nav>

      <a
        href="https://qm.qq.com/q/q9ZTy7J7R6"
        target="_blank"
        rel="noopener"
        class="group flex items-center gap-2 border border-line px-5 py-2.5 text-sm transition-colors hover:border-fg"
      >
        加入 QQ 群
        <span class="font-mono text-fg-faint transition-colors group-hover:text-fg" aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="mt-12 flex flex-col gap-1 border-t border-line pt-6 font-mono text-[11px] uppercase tracking-widest text-fg-faint sm:flex-row sm:items-center sm:justify-between">
      <span>Site Build 1.0.0</span>
      <span>© {year} MIAR // BONELAB CN Community</span>
    </div>
  </div>
</footer>
