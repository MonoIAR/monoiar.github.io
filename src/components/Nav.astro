---
const path = Astro.url.pathname;
const isLocalization = path.startsWith("/localization");

const links = [
  { href: "/#intro", label: "介绍", spy: "intro" },
  { href: "/localization", label: "汉化包", spy: null },
  { href: "/#servers", label: "服务器", spy: "servers" },
  { href: "/#staff", label: "STAFF", spy: "staff" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6" aria-label="主导航">
    <a href="/" class="group flex items-center gap-2.5">
      <span class="block size-2 bg-accent transition-transform duration-300 group-hover:scale-125" aria-hidden="true"></span>
      <span class="font-mono text-lg font-semibold uppercase tracking-[0.3em]">MIAR</span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              data-nav={l.spy}
              aria-current={isLocalization && l.label === "汉化包" ? "page" : undefined}
              class:list={[
                "relative text-sm text-fg-muted transition-colors hover:text-fg",
                isLocalization && l.label === "汉化包" && "nav-active",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      type="button"
      class="flex size-9 items-center justify-center border border-line text-fg transition-colors hover:border-fg md:hidden"
      aria-label="切换菜单"
      aria-expanded="false"
      data-menu-toggle
    >
      <svg class="size-4" data-menu-icon-open viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M2 4h12M2 8h12M2 12h12" />
      </svg>
      <svg class="hidden size-4" data-menu-icon-close viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8" />
      </svg>
    </button>
  </nav>

  <div data-menu-panel class="hidden border-t border-line bg-bg md:hidden">
    <ul class="px-6 py-2">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              data-nav={l.spy}
              class="flex items-center gap-3 border-b border-line py-4 text-sm text-fg-muted transition-colors hover:text-fg"
            >
              <span class="block size-1.5 border border-fg-faint" aria-hidden="true"></span>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // 移动端菜单开关
  const toggle = document.querySelector("[data-menu-toggle]");
  const panel = document.querySelector("[data-menu-panel]");
  const setMenu = (open) => {
    toggle?.setAttribute("aria-expanded", String(open));
    panel?.classList.toggle("hidden", !open);
    document.querySelectorAll("[data-menu-icon-open]").forEach((el) => el.classList.toggle("hidden", open));
    document.querySelectorAll("[data-menu-icon-close]").forEach((el) => el.classList.toggle("hidden", !open));
  };
  toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
  panel?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));

  // 滚动监听：高亮当前区块（仅首页有 data-spy 区块时生效）
  const links = document.querySelectorAll("[data-nav]");
  const setActive = (id) => {
    links.forEach((a) => {
      if (!a.dataset.nav) return;
      const isActive = a.dataset.nav === id;
      a.classList.toggle("nav-active", isActive);
      if (isActive) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    });
  };

  const sections = [...document.querySelectorAll("[data-spy]")];
  if (sections.length) {
    const onScroll = () => {
      const pos = window.scrollY + 120;
      let current = "";
      for (const s of sections) {
        if (s.offsetTop <= pos) current = s.dataset.spy;
      }
      setActive(current);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
