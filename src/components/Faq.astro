---
interface Item {
  q: string;
  a: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-line border border-line">
  {items.map((f) => (
    <details class="group bg-surface open:bg-bg">
      <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-5 text-sm font-medium transition-colors hover:text-fg group-open:text-fg">
        <span>{f.q}</span>
        <span class="shrink-0 font-mono text-fg-faint transition-transform duration-300 group-open:rotate-45" aria-hidden="true">＋</span>
      </summary>
      <p class="px-6 pb-6 text-sm leading-relaxed text-fg-muted">{f.a}</p>
    </details>
  ))}
</div>
