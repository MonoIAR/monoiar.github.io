---
interface Props {
  name: string;
  address: string;
  region: string;
  version: string;
  status: "online" | "offline";
}

const { name, address, region, version, status } = Astro.props;
const online = status === "online";
---

<article class="flex flex-col border border-line bg-surface p-6 transition-colors hover:border-fg/40">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-medium">{name}</h3>
    <span
      class="flex shrink-0 items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-fg-muted"
    >
      <span class:list={["size-1.5 rounded-full", online ? "bg-accent" : "bg-fg-faint"]} aria-hidden="true"></span>
      {online ? "online" : "offline"}
    </span>
  </div>

  <dl class="mt-5 flex-1 text-sm">
    <div class="flex items-center justify-between gap-3 border-t border-line py-3">
      <dt class="font-mono text-[11px] uppercase tracking-widest text-fg-faint">Addr</dt>
      <dd class="font-mono text-fg-muted">{address}</dd>
    </div>
    <div class="flex items-center justify-between gap-3 border-b border-line py-3">
      <dt class="font-mono text-[11px] uppercase tracking-widest text-fg-faint">Region</dt>
      <dd class="text-fg-muted">{region}</dd>
    </div>
    <div class="flex items-center justify-between gap-3 border-b border-line py-3">
      <dt class="font-mono text-[11px] uppercase tracking-widest text-fg-faint">Proto</dt>
      <dd class="font-mono text-fg-muted">{version}</dd>
    </div>
  </dl>
</article>
