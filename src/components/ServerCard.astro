---
import CopyIcon from './icons/CopyIcon.astro';
import { SERVER_TAG, SERVER_NAME, SERVER_DESCRIPTION } from '../data/server';
---

<div data-reveal class="hud-box p-6 space-y-4 hud-interactive">
  <div class="flex items-center justify-between">
    <span
      class="text-xs font-mono px-2 py-0.5 bg-brand-bg border border-brand-border text-brand-accent font-bold"
    >
      {SERVER_TAG}
    </span>
    <!-- 状态由 scripts/main.ts 实时填充：运行中 / 离线 / 无法连接 -->
    <span id="serverStatus" class="flex items-center gap-1.5 text-xs font-mono text-brand-textMuted">
      <span class="w-2 h-2 rounded-full bg-brand-border animate-pulse"></span> 尝试拉取中…
    </span>
  </div>

  <div>
    <h3 class="text-lg font-mono font-bold text-white">{SERVER_NAME}</h3>
    <p class="text-xs text-brand-textMuted mt-1">{SERVER_DESCRIPTION}</p>
  </div>

  <div class="grid grid-cols-3 gap-2 font-mono text-xs bg-brand-bg p-3 border border-brand-border/60">
    <div>
      <span class="text-brand-textMuted block">在线玩家</span>
      <span id="serverPlayers" class="text-white font-bold">-- / --</span>
    </div>
    <div>
      <span class="text-brand-textMuted block">当前地图</span>
      <span id="serverMap" class="text-white font-bold">--</span>
    </div>
    <div>
      <span class="text-brand-textMuted block">房间代码</span>
      <span id="serverRoomCode" class="text-white font-bold">--</span>
    </div>
  </div>

  <div class="flex items-center justify-between pt-2">
    <span class="text-xs font-mono text-brand-textMuted truncate max-w-[220px]"
      >已运行 <span id="serverUptime" class="text-white font-bold">--</span> · Fusion
      <span id="serverVersion" class="text-white font-bold">--</span></span
    >
    <button
      id="serverCopyBtn"
      type="button"
      data-copy="s203.singsi.cn:19364"
      class="px-3 py-1.5 bg-brand-surface border border-brand-border hover:border-brand-accent text-xs font-mono text-white transition-colors flex items-center gap-1"
    >
      <CopyIcon class="w-3.5 h-3.5 text-brand-accent" />
      复制服务器地址
    </button>
  </div>
</div>
