---
interface Props {
  value: string;
  label: string;
  highlight?: boolean;
}

const { value, label, highlight = false } = Astro.props;
---

<div class="bg-bg p-6">
  <div class="font-mono text-2xl tracking-tight md:text-3xl">
    <span class:list={["tabular-nums", highlight ? "text-accent" : "text-fg"]}>{value}</span>
  </div>
  <p class="mt-2 font-mono text-[11px] uppercase tracking-widest text-fg-faint">{label}</p>
</div>
