---
interface Props {
  num: string;
  title: string;
  tag?: string;
}

const { num, title, tag } = Astro.props;
---

<div class="flex items-center justify-between border-b border-brand-border pb-4">
  <div class="flex items-center gap-3">
    <span class="text-brand-accent font-mono font-bold text-lg">{num}</span>
    <h2 class="text-2xl font-mono font-bold tracking-wide uppercase">{title}</h2>
  </div>
  {tag && (
    <span class="text-xs font-mono text-brand-textMuted hidden sm:block">[{tag}]</span>
  )}
</div>
