---
interface Props {
  /** 序号占位头像，如 "01" */
  index: string;
  name: string;
  role: string;
  social?: { label: string; href: string };
}

const { index, name, role, social } = Astro.props;
---

<li class="flex items-center gap-4 px-6 py-5 transition-colors hover:bg-surface-2">
  <div
    class="flex size-10 shrink-0 items-center justify-center border border-line bg-surface-2 font-mono text-sm text-fg-muted"
    aria-hidden="true"
  >
    {index}
  </div>
  <div class="min-w-0 flex-1">
    <h3 class="truncate font-medium">{name}</h3>
    <p class="mt-0.5 truncate font-mono text-[11px] uppercase tracking-widest text-fg-faint">{role}</p>
  </div>
  {social && (
    <a
      href={social.href}
      target="_blank"
      rel="noopener"
      class="flex shrink-0 items-center gap-2 border border-line px-4 py-2 text-xs text-fg-muted transition-colors hover:border-fg hover:text-fg"
    >
      {social.label}
      <span class="font-mono" aria-hidden="true">↗</span>
    </a>
  )}
</li>
