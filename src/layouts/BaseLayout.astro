---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'MIAR中国社区',
  description = 'BONELAB 等 Stress Level Zero 游戏及其世界观的中国社区',
} = Astro.props;

// 纯 opacity 的页面切换过渡：避免 Astro 默认 fade 的 mix-blend-mode: plus-lighter
// 在深色站点上交叉淡入时短暂提亮。forwards/backwards 共用同一组 keyframes。
const hudTransition = {
  forwards: {
    old: { name: 'hud-vt-out', duration: 0.15, easing: 'ease-in-out', fillMode: 'both' },
    new: { name: 'hud-vt-in', duration: 0.2, easing: 'ease-in-out', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'hud-vt-out', duration: 0.15, easing: 'ease-in-out', fillMode: 'both' },
    new: { name: 'hud-vt-in', duration: 0.2, easing: 'ease-in-out', fillMode: 'both' },
  },
};
---

<!doctype html>
<html lang="zh-CN" class="dark scroll-smooth" transition:animate={hudTransition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/webp" href="/miar_512.webp" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@400;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // 渐进增强：只在 JS 可用时才把 reveal 元素设为 opacity:0（无 JS / 减少动效时内容始终可见）
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter />
  </head>
  <body
    class="bg-brand-bg text-brand-text min-h-screen flex flex-col relative selection:bg-brand-accent selection:text-white bg-grid-pattern"
  >
    <div id="scrollProgress" class="scroll-progress" aria-hidden="true"></div>
    <Navbar />

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 space-y-24 py-12">
      <slot />
    </main>

    <Footer />
    <Toast />

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
