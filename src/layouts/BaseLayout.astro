---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'MIAR中国社区',
  description = 'BONELAB 等 Stress Level Zero 游戏及其世界观的中国社区',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/webp" href="/miar_512.webp" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@400;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-brand-bg text-brand-text min-h-screen flex flex-col relative selection:bg-brand-accent selection:text-white bg-grid-pattern"
  >
    <Navbar />

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 space-y-24 py-12">
      <slot />
    </main>

    <Footer />
    <Toast />

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
