---
import Layout from "../layouts/Layout.astro";
import ModuleHeader from "../components/ModuleHeader.astro";
import CTA from "../components/CTA.astro";
import Stat from "../components/Stat.astro";
import ServerCard from "../components/ServerCard.astro";
import StaffCard from "../components/StaffCard.astro";
import Steps from "../components/Steps.astro";

const servers = [
  { name: "MIAR · 主服", address: "join.miar.cn:7777", region: "华东 · 上海", version: "Photon 2", status: "online" },
  { name: "MIAR · 沙盒服", address: "join.miar.cn:7778", region: "华东 · 上海", version: "Photon 2", status: "offline" },
  { name: "MIAR · 测试服", address: "join.miar.cn:7779", region: "华北 · 北京", version: "Photon 2", status: "online" },
];

const staff = [
  { name: "MIAR·团长", role: "项目统筹 / 创始人", social: { label: "Bilibili", href: "https://space.bilibili.com/" } },
  { name: "MIAR·运营", role: "社区管理", social: { label: "QQ", href: "https://qm.qq.com/q/q9ZTy7J7R6" } },
  { name: "MIAR·汉化组", role: "汉化组组长", social: { label: "Discord", href: "https://discord.gg/" } },
  { name: "MIAR·技术", role: "技术维护", social: { label: "GitHub", href: "https://github.com/" } },
  { name: "MIAR·设计", role: "视觉设计", social: { label: "X", href: "https://x.com/" } },
  { name: "MIAR·外联", role: "对外联络", social: { label: "Bilibili", href: "https://space.bilibili.com/" } },
];

const joinSteps = [
  {
    title: "进入 BONELAB 多人模式",
    desc: "在主菜单选择「多人联机」，登录 Photon 账号。",
  },
  {
    title: "输入服务器代码",
    desc: "在加入界面输入下方地址对应的服务器代码。",
  },
  {
    title: "连接进入",
    desc: "等待加载完成后即可进入，与其他成员同屏游玩。",
  },
];
---

<Layout title="MIAR // BONELAB 中文社区">

  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto flex min-h-[calc(100dvh-4rem)] max-w-5xl flex-col items-center justify-center px-6 py-20 text-center md:py-24">
      <div class="corners w-full max-w-xl px-8 py-12 md:px-12 md:py-14">
        <p class="kicker">BONELAB // CN Community</p>
        <h1 class="mt-7 font-mono text-6xl font-medium uppercase tracking-[0.24em] md:text-8xl">
          MIAR
        </h1>
        <p class="mx-auto mt-7 max-w-md text-base leading-relaxed text-fg-muted md:text-lg">
          面向中文玩家的 BONELAB 社区 —— 汉化 · 联机 · 生态
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <CTA href="/localization">下载汉化包</CTA>
          <CTA href="#servers" variant="ghost">加入服务器</CTA>
        </div>
      </div>
      <p class="mt-12 font-mono text-[11px] uppercase tracking-widest text-fg-faint">
        Status online // Players 128 // Build v2.4.1
      </p>
    </div>
  </section>

  <!-- MODULE 01 // 介绍 -->
  <section id="intro" data-spy="intro" class="scroll-mt-20 border-b border-line">
    <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
      <ModuleHeader
        no="01"
        label="Intro"
        title="关于 MIAR"
        sub="一个面向中文玩家的 BONELAB 社区，专注汉化与联机生态。"
      />

      <div class="mt-14 grid gap-12 md:grid-cols-2 md:gap-20">
        <div class="space-y-5 text-sm leading-relaxed text-fg-muted md:text-base">
          <p>
            MIAR 是一个面向中文玩家的 BONELAB 社区。我们致力于将 BONELAB
            的玩法与内容更好地呈现给中文玩家，从汉化补丁到联机生态，覆盖游戏体验的方方面面。
          </p>
          <p>
            我们持续维护并更新 BONELAB 汉化包，同时提供社区自建的联机服务器，让玩家可以更稳定地与好友一起体验沙盒世界的乐趣。
          </p>
          <p>
            如果你也热爱 BONELAB，欢迎加入我们的群聊参与讨论、提出建议，甚至加入汉化组，一起为社区贡献力量。
          </p>
        </div>

        <div class="grid grid-cols-2 gap-px self-start border border-line bg-line">
          <Stat value="1,200+" label="社区成员" highlight />
          <Stat value="02" label="汉化版本" />
          <Stat value="03" label="联机服务器" />
          <Stat value="5,000+" label="汉化词条" />
        </div>
      </div>
    </div>
  </section>

  <!-- MODULE 02 // 服务器 -->
  <section id="servers" data-spy="servers" class="scroll-mt-20 border-b border-line">
    <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
      <ModuleHeader
        no="02"
        label="Servers"
        title="自建联机服务器"
        sub="社区自建 Photon 联机服务器，稳定、低延迟。"
      />

      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-fg-muted md:text-base">
        BONELAB 使用 Photon 进行联机。MIAR 自建了多台社区服务器，供成员稳定联机、一起游玩与测试。
      </p>

      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {servers.map((s) => <ServerCard {...s} />)}
      </div>

      <h3 class="kicker mt-16">How to join // 加入方式</h3>
      <div class="mt-6 max-w-2xl">
        <Steps steps={joinSteps} />
      </div>

      <p class="mt-6 font-mono text-xs tracking-wide text-fg-faint">
        服务器地址可能变动，最新地址请
        <a
          href="https://qm.qq.com/q/q9ZTy7J7R6"
          target="_blank"
          rel="noopener"
          class="text-fg underline decoration-line underline-offset-4 transition-colors hover:text-fg-muted"
        >
          加入 QQ 群
        </a>
        获取。
      </p>
    </div>
  </section>

  <!-- MODULE 03 // STAFF -->
  <section id="staff" data-spy="staff" class="scroll-mt-20">
    <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
      <ModuleHeader
        no="03"
        label="Staff"
        title="核心 STAFF"
        sub="社区的核心成员，负责项目的长期运转。"
      />

      <ul class="mt-12 divide-y divide-line border border-line bg-surface">
        {staff.map((m, i) => <StaffCard index={String(i + 1).padStart(2, "0")} {...m} />)}
      </ul>
    </div>
  </section>

</Layout>
